---
import '../styles/global.css';
import Header from '../components/Header.astro';
import CartDrawer from '../components/CartDrawer.astro';

interface Props {
  title?: string;
  description?: string;
  showCart?: boolean;
}

const {
  title = 'Vaishali Foods | Pure Tradition, Fresh Taste',
  description =
    'Freshly prepared traditional Indian sweets and snacks, made on demand with carefully selected ingredients.',
  showCart = true
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#5b3923" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />

    <title>{title}</title>
  </head>

  <body>
    <div id="top"></div>
    <Header />

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-main">
        <div class="footer-brand">
          <a class="brand" href="/">
            <img src="/images/logo.png" alt="Vaishali Foods logo" />

            <div class="brand-copy">
              <span>Vaishali Foods</span>
              <small>PURE TRADITION, FRESH TASTE</small>
            </div>
          </a>

          <p>
            Traditional homemade sweets and savoury snacks, prepared fresh
            with care and delivered to your doorstep.
          </p>
        </div>

        <div class="footer-column">
          <h3>Explore</h3>

          <a href="/">Home</a>
          <a href="/shop">Shop</a>
          <a href="/about">Our Story</a>
          <a href="/contact">Contact</a>
        </div>

        <div class="footer-column">
          <h3>Customer Care</h3>

          <a href="/shipping-policy">Shipping Policy</a>
          <a href="/refund-policy">Refund Policy</a>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms & Conditions</a>
        </div>

        <div class="footer-column">
          <h3>Order Support</h3>

          <p>Need help choosing a product or placing a bulk order?</p>

          <a
            class="footer-whatsapp"
            href="https://wa.me/919730487916"
            target="_blank"
            rel="noreferrer"
          >
            Chat on WhatsApp
          </a>
        </div>
      </div>

      <div class="container footer-bottom">
        <span>© {currentYear} Vaishali Foods. All rights reserved.</span>
        <span>Made with care in India.</span>
      </div>
    </footer>

    {showCart && <CartDrawer />}
  </body>
</html>
