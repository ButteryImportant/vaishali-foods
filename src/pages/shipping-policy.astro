---
import PolicyLayout from '../layouts/PolicyLayout.astro';
---

<PolicyLayout
  title="Shipping Policy"
  description="Information about preparation, dispatch and delivery of Vaishali Foods orders."
>
  <section>
    <h2>Order preparation</h2>

    <p>
      Vaishali Foods prepares products freshly on demand before packing and
      dispatch.
    </p>
  </section>

  <section>
    <h2>Shipping Rates</h2>

    <p>
      We offer standard nationwide delivery with transparent flat rates based on order weight:
    </p>

    <ul>
      <li><strong>Orders up to 500g:</strong> ₹80</li>
      <li><strong>Orders above 500g:</strong> ₹140</li>
    </ul>
  </section>

  <section>
    <h2>Delivery timelines</h2>

    <p>
      Delivery normally takes approximately 3–7 business days after dispatch depending on your location.
    </p>
  </section>
</PolicyLayout>