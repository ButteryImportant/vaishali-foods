---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts, getSettings } from '../utils/db.js';
const products = await getProducts(Astro);
const settings = await getSettings(Astro);
const featuredProducts = products.filter((product) => product.featured);
---

<BaseLayout title={`${settings.siteName} | ${settings.siteDescription}`}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Homemade in Nanded, Maharashtra</span>

        <h1 set:html={settings.heroTitle}></h1>

        <p set:html={settings.heroSubtitle}></p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/shop">
            Shop bestsellers
          </a>

          <a class="btn btn-secondary" href="/about">
            Why Vaishali Foods
          </a>
        </div>
      </div>

      <div class="hero-photo">
        <img src="/images/products/dryfruit-crush-laddoo.webp" alt="Freshly made Vaishali Foods laddoos" fetchpriority="high" />

        <div class="hero-badge one">Made on demand</div>
        <div class="hero-badge two">No preservatives</div>
      </div>
    </div>
  </section>

  <div class="trust-stats">
    <div class="container trust-stats-grid">
      <div class="trust-stat">
        <strong>0%</strong>
        <span>Added sugar, ever</span>
      </div>

      <div class="trust-stat">
        <strong>100%</strong>
        <span>Made on demand</span>
      </div>

      <div class="trust-stat">
        <strong>4</strong>
        <span>Signature recipes</span>
      </div>

      <div class="trust-stat">
        <strong>Pan-India</strong>
        <span>Tracked Delhivery shipping</span>
      </div>
    </div>
  </div>

  <section class="section" id="products">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">01 - Our collection</span>
          <h2>Customer favourites</h2>
        </div>

        <p>
          Explore our most-loved traditional sweets, snacks and gift-ready
          combinations.
        </p>
      </div>

      <div class="products">
        {
          featuredProducts.map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>

      <div class="section-actions">
        <a class="btn btn-secondary" href="/shop">
          View all products
        </a>
      </div>
    </div>
  </section>

  <section class="section story" id="story">
    <div class="container story-grid">
      <div class="story-logo">
        <img src="/images/logo.png" alt="Vaishali Foods logo" />
      </div>

      <div>
        <span class="eyebrow" style="color: #ffb283;">
          Our promise
        </span>

        <h2>Homemade care in every box.</h2>

        <p>
          Vaishali Foods brings familiar Indian flavours to modern homes
          without losing the personal touch. Every order is made with attention
          to taste, hygiene and freshness.
        </p>

        <div class="chips">
          <span class="chip">Pure ingredients</span>
          <span class="chip">Made in small batches</span>
          <span class="chip">Best before 1 month</span>
          <span class="chip">Securely packed</span>
        </div>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/about">
            Read our story
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <div class="cta">
        <div>
          <span class="eyebrow" style="color: #ffd1c4;">
            Questions or bulk order?
          </span>

          <h2>Talk to Vaishali Foods.</h2>

          <p>
            We&#8217;ll help with product selection, delivery questions and custom
            gifting orders.
          </p>
        </div>

        <div class="hero-actions">
          <a
            class="btn"
            style="background: white; color: var(--red);"
            href="/contact"
          >
            Contact us
          </a>

          <a
            class="btn"
            style="background: transparent; color: white; border: 1px solid rgba(255,255,255,0.35);"
            href={`https://wa.me/${settings.whatsappNumber}`}
            target="_blank"
            rel="noreferrer"
          >
            Open WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section follow-section">
    <div class="container follow-container">
      <div>
        <h2>Follow us on Instagram</h2>
        <p>Daily updates, behind-the-scenes content, and new product launches.</p>
      </div>

      <a
        href={`https://instagram.com/${settings.instagramHandle}`}
        target="_blank"
        rel="noreferrer"
        class="btn btn-primary"
      >
        Follow @{settings.instagramHandle}
      </a>
    </div>
  </section>
</BaseLayout>





