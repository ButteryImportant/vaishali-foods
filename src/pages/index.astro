---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products.js';

const featuredProducts = products.filter((product) => product.featured);
---

<BaseLayout title="Vaishali Foods | Pure Tradition, Fresh Taste">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Homemade Maharashtrian favourites</span>

        <h1>
          Tradition you can <em>taste.</em>
        </h1>

        <p>
          Freshly prepared laddoos and snacks made on demand with carefully
          selected ingredients—packed with warmth and delivered to your
          doorstep.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/shop">
            Shop favourites
          </a>

          <a class="btn btn-secondary" href="/about">
            Why Vaishali Foods
          </a>
        </div>
      </div>

      <div class="hero-art">
        <img
          class="hero-logo"
          src="/images/logo.png"
          alt="Vaishali Foods emblem"
        />

        <div class="hero-badge one">✨ Made on demand</div>
        <div class="hero-badge two">🌿 No preservatives</div>
      </div>
    </div>
  </section>

  <div class="container trust-row">
    <div class="trust">
      <span class="trust-icon">🪔</span>

      <div>
        <strong>Authentic recipes</strong>
        <small>Traditional taste, thoughtfully prepared</small>
      </div>
    </div>

    <div class="trust">
      <span class="trust-icon">📦</span>

      <div>
        <strong>Freshly packed</strong>
        <small>Prepared after your order</small>
      </div>
    </div>

    <div class="trust">
      <span class="trust-icon">🚚</span>

      <div>
        <strong>Doorstep delivery</strong>
        <small>Secure shipping across serviceable PIN codes</small>
      </div>
    </div>
  </div>

  <section class="section" id="products">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Our collection</span>
          <h2>Customer favourites</h2>
        </div>

        <p>
          Explore our most-loved traditional sweets, snacks and gift-ready
          combinations.
        </p>
      </div>

      <div class="products">
        {
          featuredProducts.map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>

      <div class="section-actions">
        <a class="btn btn-secondary" href="/shop">
          View all products
        </a>
      </div>
    </div>
  </section>

  <section class="section story" id="story">
    <div class="container story-grid">
      <div class="story-logo">
        <img src="/images/logo.png" alt="Vaishali Foods logo" />
      </div>

      <div>
        <span class="eyebrow" style="color: #ffb283;">
          Our promise
        </span>

        <h2>Homemade care in every box.</h2>

        <p>
          Vaishali Foods brings familiar Indian flavours to modern homes
          without losing the personal touch. Every order is made with attention
          to taste, hygiene and freshness.
        </p>

        <div class="chips">
          <span class="chip">Pure ingredients</span>
          <span class="chip">Made in small batches</span>
          <span class="chip">Best before 1 month</span>
          <span class="chip">Securely packed</span>
        </div>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/about">
            Read our story
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <div class="cta">
        <div>
          <span class="eyebrow" style="color: #ffd1c4;">
            Questions or bulk order?
          </span>

          <h2>Talk to Vaishali Foods.</h2>

          <p>
            We’ll help with product selection, delivery questions and custom
            gifting orders.
          </p>
        </div>

        <div class="hero-actions">
          <a
            class="btn"
            style="background: white; color: var(--red);"
            href="/contact"
          >
            Contact us
          </a>

          <a
            class="btn"
            style="background: transparent; color: white; border: 1px solid rgba(255,255,255,0.35);"
            href="https://wa.me/919730487916"
            target="_blank"
            rel="noreferrer"
          >
            Open WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section testimonials-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">What customers say</span>
          <h2>Loved by families</h2>
        </div>

        <p>
          Real feedback from customers who trust Vaishali Foods for their
          celebrations and everyday moments.
        </p>
      </div>

      <div class="testimonials-grid">
        <article class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>

          <p class="testimonial-text">
            "The laddoos taste exactly like homemade ones. The quality and
            freshness are unmatched. Perfect for gifting!"
          </p>

          <div class="testimonial-author">
            <span class="author-name">Priya M.</span>
            <span class="author-location">Mumbai</span>
          </div>
        </article>

        <article class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>

          <p class="testimonial-text">
            "Ordered for my family in Delhi. Delivered in perfect condition and
            tasted amazing. Will definitely order again!"
          </p>

          <div class="testimonial-author">
            <span class="author-name">Rajesh K.</span>
            <span class="author-location">Delhi</span>
          </div>
        </article>

        <article class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>

          <p class="testimonial-text">
            "No artificial preservatives, made with care. My kids loved the
            Ragi Laddoo. This is how traditional sweets should be!"
          </p>

          <div class="testimonial-author">
            <span class="author-name">Anjali S.</span>
            <span class="author-location">Bangalore</span>
          </div>
        </article>

        <article class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>

          <p class="testimonial-text">
            "Excellent packaging and very fresh. The Almond Protein Laddoo is
            my go-to post-workout snack now!"
          </p>

          <div class="testimonial-author">
            <span class="author-name">Vikram D.</span>
            <span class="author-location">Pune</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section follow-section">
    <div class="container follow-container">
      <div>
        <h2>Follow us on Instagram</h2>
        <p>Daily updates, behind-the-scenes content, and new product launches.</p>
      </div>

      <a
        href="https://instagram.com/vaishali.foods"
        target="_blank"
        rel="noreferrer"
        class="btn btn-primary"
      >
        Follow @vaishali.foods
      </a>
    </div>
  </section>
</BaseLayout>
