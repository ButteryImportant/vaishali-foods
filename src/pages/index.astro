---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts, getSettings } from '../utils/db.js';
const products = await getProducts(Astro);
const settings = await getSettings(Astro);
const featuredProducts = products.filter((product) => product.featured);
---

<BaseLayout title={`${settings.siteName} | ${settings.siteDescription}`}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Homemade in Nanded, Maharashtra</span>

        <h1 set:html={settings.heroTitle}></h1>

        <p set:html={settings.heroSubtitle}></p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/shop">
            Shop bestsellers
          </a>

          <a class="btn btn-secondary" href="/about">
            Why Vaishali Foods
          </a>
        </div>
      </div>

      <div class="hero-photo">
        <img src="/images/products/dryfruit-crush-laddoo.webp" alt="Freshly made Vaishali Foods laddoos" fetchpriority="high" />

        <div class="hero-badge one">Made on demand</div>
        <div class="hero-badge two">No preservatives</div>
      </div>
    </div>
  </section>

  <div class="trust-stats">
    <div class="container trust-stats-grid">
      <div class="trust-stat">
        <strong>0%</strong>
        <span>Added sugar, ever</span>
      </div>

      <div class="trust-stat">
        <strong>100%</strong>
        <span>Made on demand</span>
      </div>

      <div class="trust-stat">
        <strong>Razorpay</strong>
        <span>Secure UPI & card payments</span>
      </div>

      <div class="trust-stat">
        <strong>Delhivery</strong>
        <span>Tracked doorstep shipping</span>
      </div>
    </div>
  </div>

  <section class="section" id="products">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">01 - Our collection</span>
          <h2>Customer favourites</h2>
        </div>

        <p>
          Explore our most-loved traditional sweets, snacks and gift-ready
          combinations.
        </p>
      </div>

      <div class="products">
        {
          featuredProducts.map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>

      <div class="section-actions">
        <a class="btn btn-secondary" href="/shop">
          View all products
        </a>
      </div>
    </div>
  </section>

  <section class="section story" id="story">
    <div class="container story-centered">
      <span class="eyebrow" style="color: #e8b48f;">
        02 - Our craft
      </span>

      <h2>Homemade care in every box.</h2>

      <p>
        Vaishali Foods brings familiar Indian flavours to modern homes
        without losing the personal touch. Every order is made with attention
        to taste, hygiene and freshness.
      </p>

      <div class="chips">
        <span class="chip">Pure ingredients</span>
        <span class="chip">Made in small batches</span>
        <span class="chip">Best before 1 month</span>
        <span class="chip">Securely packed</span>
      </div>

      <div class="story-cta">
        <a class="btn btn-primary" href="/about">
          Read our story
        </a>

        <a class="story-link" href="/founders">
          Meet our founder
        </a>
      </div>
    </div>
  </section>

  <section class="section steps-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">03 - How it works</span>
          <h2>From our kitchen to your door</h2>
        </div>

        <p>
          No pre-packed stock, no middlemen. Just a short path between
          Vaishali's kitchen and your home.
        </p>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <span class="step-number">01</span>
          <h3>You order</h3>
          <p>Pick your laddoos and check out securely with Razorpay.</p>
        </article>

        <article class="step-card">
          <span class="step-number">02</span>
          <h3>We cook fresh</h3>
          <p>Your box is prepared only after you order. Nothing pre-packed.</p>
        </article>

        <article class="step-card">
          <span class="step-number">03</span>
          <h3>Delhivery delivers</h3>
          <p>Tracked shipping to your PIN code, calculated at checkout.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section talk-section" id="contact">
    <div class="container">
      <div class="talk-card">
        <div>
          <span class="eyebrow">Questions or bulk orders?</span>
          <h2>Talk to Vaishali Foods.</h2>
          <p>
            Product selection, delivery questions and custom orders -
            answered personally on WhatsApp.
          </p>
        </div>

        <div class="talk-actions">
          <a
            class="btn btn-primary"
            href={`https://wa.me/${settings.whatsappNumber}`}
            target="_blank"
            rel="noreferrer"
          >
            Chat on WhatsApp
          </a>

          <a
            class="talk-instagram"
            href={`https://instagram.com/${settings.instagramHandle}`}
            target="_blank"
            rel="noreferrer"
          >
            @{settings.instagramHandle} on Instagram
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>





