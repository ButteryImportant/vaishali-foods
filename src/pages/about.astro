---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Our Story | Vaishali Foods"
  description="Learn about Vaishali Foods, our homemade recipes, fresh preparation and commitment to traditional taste."
>
  <section class="about-hero">
    <div class="container about-hero-grid">
      <div>
        <span class="eyebrow">Our story</span>
        <h1>Food made with the warmth of home.</h1>
        <p>
          Vaishali Foods was created to bring traditional Maharashtrian sweets
          and snacks to families who value freshness, honest ingredients and
          authentic homemade taste.
        </p>

        <div class="about-actions">
          <a class="btn btn-primary" href="/shop">Explore our products</a>
          <a class="btn btn-secondary" href="/contact">Contact us</a>
        </div>
      </div>

      <div class="about-hero-card">
        <img src="/images/logo.png" alt="Vaishali Foods logo" />
        <span>Pure Tradition</span>
        <strong>Fresh Taste</strong>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-story-grid">
      <div class="about-story-image">
        <span>Fresh product photograph coming soon</span>
      </div>

      <div class="about-story-copy">
        <span class="eyebrow">Made with care</span>
        <h2>Traditional recipes, prepared fresh for every order.</h2>

        <p>
          Our products are made in small batches using carefully selected
          ingredients. We focus on familiar flavours, consistent quality and
          the comfort of food that feels genuinely homemade.
        </p>

        <p>
          Since our products are prepared on demand, every order receives the
          attention it deserves&#8212;from preparation and packing to final delivery.
        </p>
      </div>
    </div>
  </section>

  <section class="about-values">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">What matters to us</span>
          <h2>The Vaishali Foods promise</h2>
        </div>
      </div>

      <div class="about-values-grid">
        <article class="about-value-card">
          <span>01</span>
          <h3>Freshly prepared</h3>
          <p>
            Products are prepared on demand instead of being stored for long
            periods.
          </p>
        </article>

        <article class="about-value-card">
          <span>02</span>
          <h3>Honest ingredients</h3>
          <p>
            We use familiar ingredients and clearly communicate what goes into
            every product.
          </p>
        </article>

        <article class="about-value-card">
          <span>03</span>
          <h3>Traditional taste</h3>
          <p>
            Our recipes are inspired by the flavours families have enjoyed for
            generations.
          </p>
        </article>

        <article class="about-value-card">
          <span>04</span>
          <h3>Packed with care</h3>
          <p>
            Each order is packed carefully to help preserve freshness during
            delivery.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="about-cta">
    <div class="container">
      <div class="about-cta-card">
        <div>
          <span class="eyebrow">Taste the tradition</span>
          <h2>Discover your next favourite.</h2>
        </div>

        <a class="btn btn-primary" href="/shop">Shop now</a>
      </div>
    </div>
  </section>
</BaseLayout>