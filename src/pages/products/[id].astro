---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProducts } from '../../utils/db.js';

const products = await getProducts(Astro);
const { id } = Astro.params;
const product = products.find(p => p.id === id);

if (!product) {
  return Astro.redirect('/404');
}

const firstVariant = product.variants[0];
---

<BaseLayout title={`${product.name} | Vaishali Foods`}>
  <section class="product-detail">
    <div class="container product-detail-grid">
      <div class="product-detail-image">
        <img
          src={product.image}
          alt={product.name}
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="product-detail-content">
        <div class="product-detail-header">
          <h1>{product.name}</h1>
          <p class="product-detail-note">{product.note}</p>
        </div>

        <div class="product-detail-section">
          <h3>Select weight</h3>

          <div class="variant-picker-detail" role="group" aria-label={`Choose weight for ${product.name}`}>
            {
              product.variants.map((variant, index) => (
                <button
                  type="button"
                  class:list={[
                    'variant-option-detail',
                    { active: index === 0 }
                  ]}
                  data-weight={variant.weight}
                  data-variant-id={variant.id}
                  data-weight-grams={variant.weightGrams}
                  data-price={variant.price ?? ''}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <span class="variant-weight">{variant.weight}</span>
                  {variant.price && <span class="variant-price">₹{variant.price}</span>}
                </button>
              ))
            }
          </div>
        </div>

        <div class="product-detail-section">
          <span class="product-price-display">
            Price: <strong class="selected-price">₹{firstVariant.price}</strong>
          </span>
        </div>

        <div class="product-detail-actions">
          <button
            type="button"
            class="btn btn-primary add-to-cart"
            data-product={JSON.stringify({
              ...product,
              variantId: firstVariant.id,
              weight: firstVariant.weight,
              weightGrams: firstVariant.weightGrams,
              price: firstVariant.price
            })}
            disabled={firstVariant.price === null}
          >
            {firstVariant.price === null ? 'Coming Soon' : 'Add to Cart'}
          </button>
        </div>

        <div class="product-detail-info">
          <div class="info-card">
            <span class="info-icon">📦</span>
            <div>
              <h4>Made Fresh</h4>
              <p>Prepared fresh after your order</p>
            </div>
          </div>

          <div class="info-card">
            <span class="info-icon">🚚</span>
            <div>
              <h4>Fast Delivery</h4>
              <p>Shipped securely to your doorstep</p>
            </div>
          </div>

          <div class="info-card">
            <span class="info-icon">✨</span>
            <div>
              <h4>No Preservatives</h4>
              <p>Pure ingredients, traditional recipe</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Our other favourites</h2>
      </div>

      <div class="products">
        {
          products
            .filter((p) => p.id !== product.id)
            .slice(0, 4)
            .map((relatedProduct) => (
              <a href={`/products/${relatedProduct.id}`} class="product-card-link">
                <article class="card product-card">
                  <div class="product-image-wrap">
                    <img
                      class="product-image"
                      src={relatedProduct.image}
                      alt={relatedProduct.name}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="card-body">
                    <div class="card-top">
                      <h3>{relatedProduct.name}</h3>
                      <span class="price product-price">
                        ₹{relatedProduct.variants[0].price}
                      </span>
                    </div>
                  </div>
                </article>
              </a>
            ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-detail {
    padding: 3rem 0;
    background: linear-gradient(135deg, rgba(91, 57, 35, 0.05) 0%, rgba(255, 178, 131, 0.05) 100%);
  }

  .product-detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .product-detail-image {
    position: sticky;
    top: 2rem;
  }

  .product-detail-image img {
    width: 100%;
    border-radius: 12px;
    object-fit: cover;
  }

  .product-detail-header {
    margin-bottom: 2rem;
  }

  .product-detail-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: #1a1a1a;
  }

  .product-detail-note {
    font-size: 1.1rem;
    color: #666;
    line-height: 1.6;
  }

  .product-detail-section {
    margin-bottom: 2rem;
  }

  .product-detail-section h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: #1a1a1a;
  }

  .variant-picker-detail {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .variant-option-detail {
    flex: 1;
    min-width: 120px;
    padding: 1rem;
    border: 2px solid #e0e0e0;
    background: white;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .variant-option-detail:hover {
    border-color: var(--red);
  }

  .variant-option-detail.active {
    border-color: var(--red);
    background: rgba(255, 178, 131, 0.1);
  }

  .variant-weight {
    font-weight: 600;
    color: #1a1a1a;
  }

  .variant-price {
    font-size: 0.9rem;
    color: var(--red);
    font-weight: 600;
  }

  .product-price-display {
    font-size: 1.2rem;
    color: #666;
  }

  .selected-price {
    color: var(--red);
    font-size: 1.5rem;
  }

  .product-detail-actions {
    margin: 2rem 0;
  }

  .product-detail-actions .btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
  }

  .product-detail-info {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e0e0e0;
  }

  .info-card {
    display: flex;
    gap: 1rem;
  }

  .info-icon {
    font-size: 2rem;
    min-width: 40px;
  }

  .info-card h4 {
    margin: 0 0 0.25rem 0;
    color: #1a1a1a;
  }

  .info-card p {
    margin: 0;
    font-size: 0.9rem;
    color: #666;
  }

  .product-card-link {
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 768px) {
    .product-detail-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .product-detail-image {
      position: static;
    }

    .product-detail-header h1 {
      font-size: 1.8rem;
    }

    .variant-picker-detail {
      gap: 0.75rem;
    }

    .variant-option-detail {
      min-width: 100px;
      padding: 0.75rem;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('.variant-picker-detail').forEach((picker) => {
    const options = picker.querySelectorAll('.variant-option-detail');
    const priceDisplay = document.querySelector('.selected-price');
    const addButton = document.querySelector('.product-detail-actions .add-to-cart');

    options.forEach((option) => {
      option.addEventListener('click', () => {
        options.forEach((item) => {
          item.classList.remove('active');
          item.setAttribute('aria-pressed', 'false');
        });

        option.classList.add('active');
        option.setAttribute('aria-pressed', 'true');

        const weight = option.dataset.weight;
        const variantId = option.dataset.variantId;
        const weightGrams = Number(option.dataset.weightGrams);
        const rawPrice = option.dataset.price;
        const price = rawPrice === '' ? null : Number(rawPrice);

        const product = JSON.parse(addButton.dataset.product);

        priceDisplay.textContent = price === null ? 'Price coming soon' : `₹${price}`;

        addButton.disabled = price === null;
        addButton.textContent = price === null ? 'Coming Soon' : 'Add to Cart';

        addButton.dataset.product = JSON.stringify({
          ...product,
          variantId,
          weight,
          weightGrams,
          price
        });
      });
    });
  });
</script>
