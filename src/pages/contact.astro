---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '../utils/db.js';
const settings = await getSettings(Astro);
const whatsappLink = `https://wa.me/${settings.whatsappNumber}`;
const telLink = `tel:+${settings.whatsappNumber}`;
const instagramUrl = `https://instagram.com/${settings.instagramHandle}`;
---

<BaseLayout
  title="Contact | Vaishali Foods"
  description="Contact Vaishali Foods for product questions, bulk orders, delivery support and order assistance."
>
  <section class="contact-hero">
    <div class="container contact-hero-grid">
      <div class="contact-hero-copy">
        <span class="eyebrow">Get in touch</span>

        <h1>We&#8217;re here to help with your order.</h1>

        <p>
          Contact us for product questions, bulk orders, delivery support or
          help choosing the right sweets and snacks.
        </p>

        <div class="contact-hero-actions">
          <a
            class="btn btn-primary"
            href={whatsappLink}
            target="_blank"
            rel="noreferrer"
          >
            Chat on WhatsApp
          </a>

          <a class="btn btn-secondary" href={telLink}>
            Call us
          </a>
        </div>
      </div>

      <div class="contact-hero-card">
        <span>Order support</span>
        <strong>Freshly prepared and packed with care.</strong>

        <div class="contact-hero-details">
          <div>
            <small>Response time</small>
            <b>Usually within a few hours</b>
          </div>

          <div>
            <small>Order type</small>
            <b>Retail and bulk orders</b>
          </div>

          <div>
            <small>Delivery</small>
            <b>Across serviceable Indian PIN codes</b>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <div class="contact-info">
        <span class="eyebrow">Contact details</span>
        <h2>Choose the easiest way to reach us.</h2>

        <div class="contact-methods">
          <article class="contact-method">
            <span class="contact-method-number">01</span>

            <div>
              <h3>WhatsApp</h3>
              <p>
                Best for placing orders, sharing your address and asking about
                product availability.
              </p>

              <a
                href={whatsappLink}
                target="_blank"
                rel="noreferrer"
              >
                Message Vaishali Foods
              </a>
            </div>
          </article>

          <article class="contact-method">
            <span class="contact-method-number">02</span>

            <div>
              <h3>Phone</h3>
              <p>
                Call us for urgent order help, bulk enquiries or delivery
                questions.
              </p>

              <a href={telLink}>{settings.phoneDisplay}</a>
            </div>
          </article>

          <article class="contact-method">
            <span class="contact-method-number">03</span>

            <div>
              <h3>Email</h3>
              <p>
                Use email for business enquiries, partnerships and detailed
                support requests.
              </p>

              <a href={`mailto:${settings.contactEmail}`}>
                {settings.contactEmail}
              </a>
            </div>
          </article>

          <article class="contact-method">
            <span class="contact-method-number">04</span>

            <div>
              <h3>Instagram</h3>
              <p>
                Follow us for product updates, offers, behind-the-scenes content
                and new launches.
              </p>

              <a
                href={instagramUrl}
                target="_blank"
                rel="noreferrer"
              >
                @{settings.instagramHandle}
              </a>
            </div>
          </article>
        </div>
      </div>

      <aside class="contact-form-card">
        <span class="eyebrow">Send an enquiry</span>
        <h2>Tell us how we can help.</h2>

        <form class="contact-form" id="contact-form">
          <label>
            Full name
            <input
              type="text"
              name="name"
              autocomplete="name"
              placeholder="Your name"
              required
            />
          </label>

          <label>
            Phone number
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              placeholder="+91"
              required
            />
          </label>

          <label>
            Email address
            <input
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@example.com"
            />
          </label>

          <label>
            Enquiry type
            <select name="type">
              <option>Product question</option>
              <option>Order support</option>
              <option>Bulk order</option>
              <option>Delivery enquiry</option>
              <option>Business enquiry</option>
            </select>
          </label>

          <label>
            Message
            <textarea
              name="message"
              rows="5"
              placeholder="Tell us what you need"
              required
            ></textarea>
          </label>

          <button class="btn btn-primary" type="submit">
            Continue on WhatsApp
          </button>

          <p class="contact-form-note">
            This form will prepare your message and open WhatsApp. It does not
            store your details yet.
          </p>
        </form>
      </aside>
    </div>
  </section>

  <section class="contact-faq-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Quick answers</span>
          <h2>Frequently asked questions</h2>
        </div>
      </div>

      <div class="contact-faq-grid">
        <article>
          <h3>Are products prepared fresh?</h3>
          <p>
            Yes. Vaishali Foods prepares products on demand instead of keeping
            large quantities stored for long periods.
          </p>
        </article>

        <article>
          <h3>Do you accept bulk orders?</h3>
          <p>
            Yes. Contact us in advance with the product, quantity and required
            delivery date.
          </p>
        </article>

        <article>
          <h3>How is delivery charged?</h3>
          <p>
            Shipping depends on the order weight, destination PIN code and
            available courier options.
          </p>
        </article>

        <article>
          <h3>How can I track my order?</h3>
          <p>
            Tracking details will be shared after dispatch. A dedicated tracking
            page will also be added after Delhivery integration.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ whatsappNumber: settings.whatsappNumber }}>
  const form = document.querySelector('#contact-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const data = new FormData(form);

    const name = data.get('name');
    const phone = data.get('phone');
    const email = data.get('email') || 'Not provided';
    const type = data.get('type');
    const message = data.get('message');

    const whatsappMessage = [
      'Hello Vaishali Foods,',
      '',
      `Name: ${name}`,
      `Phone: ${phone}`,
      `Email: ${email}`,
      `Enquiry type: ${type}`,
      '',
      `Message: ${message}`
    ].join('\n');

    window.open(
      `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
        whatsappMessage
      )}`,
      '_blank'
    );
  });
</script>
