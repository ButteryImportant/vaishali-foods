---
const title = "Vaishali Admin | Dashboard";
---

<!doctype html>
<html lang="en" class="antialiased text-slate-900 bg-slate-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style is:global>
    /* Modern Reset & Base Variables (Shadcn/Vercel inspired) */
    :root {
      --bg: #f8fafc;
      --card: #ffffff;
      --card-border: #e2e8f0;
      --text: #0f172a;
      --text-muted: #64748b;
      --primary: #0f172a;
      --primary-fg: #f8fafc;
      --accent: #f1f5f9;
      --accent-fg: #0f172a;
      --destructive: #ef4444;
      --destructive-fg: #f8fafc;
      --ring: rgba(15, 23, 42, 0.2);
      --radius: 0.75rem;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
      --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 0.05), 0 4px 6px -4px rgb(0 0 0 / 0.05);
      --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    }
    
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; line-height: 1.5; }
    button, input, select, textarea { font-family: inherit; }
    a { color: inherit; text-decoration: none; }
    .hidden { display: none !important; }

    /* UI Primitives */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 500;
      border-radius: calc(var(--radius) - 2px); border: 1px solid transparent;
      cursor: pointer; transition: all 0.15s; white-space: nowrap;
    }
    .btn:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
    .btn:disabled { opacity: 0.5; pointer-events: none; }
    .btn-primary { background: var(--primary); color: var(--primary-fg); }
    .btn-primary:hover { background: #334155; }
    .btn-secondary { background: var(--card); border-color: var(--card-border); color: var(--text); }
    .btn-secondary:hover { background: var(--accent); }
    .btn-danger { background: #fee2e2; color: #991b1b; }
    .btn-danger:hover { background: #fecaca; }
    .btn-ghost { background: transparent; color: var(--text-muted); }
    .btn-ghost:hover { background: var(--accent); color: var(--accent-fg); }
    .btn-icon { padding: 0.5rem; }
    
    .input {
      display: flex; width: 100%;
      border-radius: calc(var(--radius) - 2px); border: 1px solid var(--card-border);
      background: transparent; padding: 0.5rem 0.75rem; font-size: 0.875rem;
      transition: border-color 0.15s;
    }
    .input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary); }
    .label { display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.375rem; color: var(--text); }
    .hint { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }

    .card { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; }
    .card-header { padding: 1.5rem 1.5rem 0; }
    .card-title { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.025em; }
    .card-desc { font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem; }
    .card-content { padding: 1.5rem; }

    .badge {
      display: inline-flex; align-items: center; padding: 0.125rem 0.625rem;
      border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
    }
    .badge-green { background: #dcfce7; color: #166534; }
    .badge-amber { background: #fef3c7; color: #92400e; }
    .badge-blue { background: #e0f2fe; color: #075985; }

    /* Login View */
    #login-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1rem; }
    .login-box { width: 100%; max-width: 400px; }
    .login-box .card { padding: 2rem; }
    .login-logo { width: 48px; height: 48px; margin: 0 auto 1.5rem; border-radius: 12px; }
    .login-box h1 { text-align: center; font-size: 1.5rem; font-weight: 600; margin-bottom: 0.25rem; letter-spacing: -0.025em; }
    .login-box p { text-align: center; color: var(--text-muted); font-size: 0.875rem; margin-bottom: 2rem; }
    .login-error { margin-top: 1rem; font-size: 0.875rem; color: var(--destructive); text-align: center; font-weight: 500; }

    /* Dashboard Layout */
    #dashboard-page { display: flex; min-height: 100vh; }
    
    .sidebar {
      width: 250px; border-right: 1px solid var(--card-border); background: var(--card);
      display: flex; flex-direction: column; padding: 1.5rem 1rem; position: fixed; top: 0; bottom: 0; z-index: 40;
    }
    .brand { display: flex; align-items: center; gap: 0.75rem; padding: 0 0.5rem 1.5rem; margin-bottom: 1rem; }
    .brand img { width: 32px; height: 32px; border-radius: 8px; }
    .brand-text { font-weight: 600; font-size: 1rem; letter-spacing: -0.01em; }
    
    .nav-links { display: flex; flex-direction: column; gap: 0.25rem; flex: 1; }
    .nav-item {
      display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem;
      border-radius: calc(var(--radius) - 2px); color: var(--text-muted); font-size: 0.875rem; font-weight: 500;
      cursor: pointer; transition: all 0.15s;
    }
    .nav-item svg { width: 18px; height: 18px; opacity: 0.7; }
    .nav-item:hover { background: var(--accent); color: var(--accent-fg); }
    .nav-item.active { background: var(--accent); color: var(--primary); font-weight: 600; }
    .nav-item.active svg { opacity: 1; }
    
    .main-content { flex: 1; min-width: 0; margin-left: 250px; padding: 2rem 3rem; max-width: 1400px; }
    .panel { display: none; animation: fadeIn 0.3s ease; }
    .panel.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
    
    .header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; }
    .header h1 { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.025em; }
    .header p { color: var(--text-muted); margin-top: 0.25rem; }

    /* Overview Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem; }
    .stat-card { padding: 1.5rem; }
    .stat-header { display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); margin-bottom: 0.5rem; font-size: 0.875rem; font-weight: 500; }
    .stat-icon { color: var(--text-muted); opacity: 0.5; }
    .stat-val { font-size: 2rem; font-weight: 700; letter-spacing: -0.025em; }

    /* Tables */
    .table-container { width: 100%; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem; }
    th { font-weight: 500; color: var(--text-muted); padding: 1rem 1.5rem; border-bottom: 1px solid var(--card-border); white-space: nowrap; }
    td { padding: 1rem 1.5rem; border-bottom: 1px solid var(--card-border); vertical-align: top; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: var(--accent); }
    .cell-id { font-family: monospace; color: var(--text-muted); }
    .cell-items { color: var(--text-muted); font-size: 0.8rem; line-height: 1.4; }

    /* Products Grid */
    .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 1.5rem; }
    .product-card { display: flex; flex-direction: column; min-width: 0; }
    .pc-img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-bottom: 1px solid var(--card-border); background: var(--accent); }
    .pc-body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; }
    .pc-title { font-weight: 600; font-size: 1rem; margin-bottom: 0.25rem; }
    .pc-note { font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; margin-bottom: 1rem; flex: 1; }
    .pc-variants { background: var(--bg); border-radius: calc(var(--radius) - 4px); padding: 0.75rem; margin-bottom: 1rem; font-size: 0.8rem; border: 1px solid var(--card-border); }
    .pc-variant-row { display: flex; justify-content: space-between; margin-bottom: 0.25rem; }
    .pc-variant-row:last-child { margin-bottom: 0; }
    .pc-weight { font-weight: 500; }
    .pc-price { font-weight: 600; color: var(--primary); }
    .pc-actions { display: grid; grid-template-columns: 1fr auto; gap: 0.5rem; margin-top: auto; }

    /* Modal */
    .modal-backdrop { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(2px); z-index: 100; display: flex; align-items: center; justify-content: center; padding: 1rem; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
    .modal-backdrop.open { opacity: 1; pointer-events: auto; }
    .modal { background: var(--card); border-radius: var(--radius); width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-lg); transform: scale(0.95); transition: transform 0.2s; }
    .modal-backdrop.open .modal { transform: scale(1); }
    .modal-header { padding: 1.5rem; border-bottom: 1px solid var(--card-border); display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; background: var(--card); z-index: 10; }
    .modal-title { font-size: 1.125rem; font-weight: 600; }
    .modal-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
    .modal-footer { padding: 1.5rem; border-top: 1px solid var(--card-border); display: flex; justify-content: flex-end; gap: 0.75rem; background: var(--bg); position: sticky; bottom: 0; }
    
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    
    .variant-row { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 0.5rem; align-items: center; background: var(--bg); padding: 0.5rem; border-radius: calc(var(--radius) - 2px); border: 1px solid var(--card-border); margin-bottom: 0.5rem; }

    /* Toast */
    .toast-container { position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 200; display: flex; flex-direction: column; gap: 0.5rem; }
    .toast { background: var(--primary); color: var(--primary-fg); padding: 1rem 1.25rem; border-radius: var(--radius); font-size: 0.875rem; font-weight: 500; box-shadow: var(--shadow-lg); transform: translateY(100%); opacity: 0; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); display: flex; align-items: center; gap: 0.75rem; }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.error { background: var(--destructive); color: var(--destructive-fg); }

    /* Responsive */
    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); transition: transform 0.3s; }
      .sidebar.open { transform: translateX(0); }
      .main-content { margin-left: 0; padding: 1.5rem 1rem; }
      .mobile-header { display: flex; align-items: center; justify-content: space-between; padding: 1rem; background: var(--card); border-bottom: 1px solid var(--card-border); margin: -1.5rem -1rem 1.5rem; }
      .header { flex-direction: column; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem; }
      .header-actions { width: 100%; display: flex; }
      .header-actions .btn { flex: 1; }
      .grid-2 { grid-template-columns: 1fr; }
      .variant-row { grid-template-columns: 1fr 1fr auto; }
      .variant-row .input:first-child { grid-column: 1 / -1; }
    }
  </style>
</head>
<body>

  <div id="login-page">
    <div class="login-box">
      <img class="login-logo" src="/images/logo.png" alt="Logo" />
      <h1>Welcome back</h1>
      <p>Enter your credentials to access the dashboard</p>
      
      <div class="card">
        <form id="login-form" class="modal-body" style="padding: 0;">
          <div>
            <label class="label">Username</label>
            <input type="text" id="username" class="input" placeholder="admin" required />
          </div>
          <div>
            <label class="label">Password</label>
            <input type="password" id="password" class="input" placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢" required />
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem; padding: 0.75rem;">Sign In</button>
          <div id="login-error" class="login-error hidden"></div>
        </form>
      </div>
    </div>
  </div>

  <div id="dashboard-page" class="hidden">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <img src="/images/logo.png" alt="Logo" />
        <span class="brand-text">Vaishali Admin</span>
      </div>
      <nav class="nav-links">
        <a class="nav-item active" data-target="overview">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
          Overview
        </a>
        <a class="nav-item" data-target="orders">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          Orders
        </a>
        <a class="nav-item" data-target="products">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
          Products
        </a>
        <a class="nav-item" data-target="settings">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          Site Config
        </a>
      </nav>
      <div style="margin-top: auto;">
        <button id="logout-btn" class="btn btn-ghost" style="width: 100%; justify-content: flex-start;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
          Sign Out
        </button>
      </div>
    </aside>

    <main class="main-content">
      <div class="mobile-header hidden" id="mobile-header">
        <span class="brand-text">Vaishali Admin</span>
        <button class="btn btn-icon btn-ghost" onclick="document.getElementById('sidebar').classList.toggle('open')">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>

      <!-- Overview -->
      <div class="panel active" id="view-overview">
        <div class="header">
          <div>
            <h1>Dashboard</h1>
            <p>Welcome back. Here's a snapshot of your store.</p>
          </div>
        </div>
        
        <div class="stats-grid">
          <div class="card stat-card">
            <div class="stat-header">
              <span>Total Revenue</span>
              <svg class="stat-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="stat-val" id="stat-rev">â‚¹0</div>
          </div>
          <div class="card stat-card">
            <div class="stat-header">
              <span>Orders</span>
              <svg class="stat-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <div class="stat-val" id="stat-orders">0</div>
          </div>
          <div class="card stat-card">
            <div class="stat-header">
              <span>Active Products</span>
              <svg class="stat-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            </div>
            <div class="stat-val" id="stat-products">0</div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Recent Orders</h2>
          </div>
          <div class="card-content" style="padding: 0; margin-top: 1.5rem;">
            <div class="table-container">
              <table>
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th style="text-align: right;">Amount</th>
                  </tr>
                </thead>
                <tbody id="overview-orders">
                  <tr><td colspan="5" style="text-align:center; padding: 3rem; color: var(--text-muted);">Loading...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Orders -->
      <div class="panel" id="view-orders">
        <div class="header">
          <div>
            <h1>Orders</h1>
            <p>Manage and view all customer orders.</p>
          </div>
        </div>
        <div class="card">
          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Order ID</th>
                  <th>Date</th>
                  <th>Customer Info</th>
                  <th>Items</th>
                  <th>Status</th>
                  <th style="text-align: right;">Total</th>
                </tr>
              </thead>
              <tbody id="all-orders">
                <tr><td colspan="6" style="text-align:center; padding: 3rem; color: var(--text-muted);">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Products -->
      <div class="panel" id="view-products">
        <div class="header">
          <div>
            <h1>Products</h1>
            <p>Add, edit, or remove products from your catalog.</p>
          </div>
          <div class="header-actions">
            <button class="btn btn-primary" onclick="openProductModal()">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              New Product
            </button>
          </div>
        </div>
        
        <div class="products-grid" id="products-grid">
          <div style="grid-column: 1/-1; text-align:center; padding: 4rem; color: var(--text-muted);">Loading...</div>
        </div>
      </div>

      <!-- Settings -->
      <div class="panel" id="view-settings">
        <div class="header">
          <div>
            <h1>Site Configuration</h1>
            <p>Manage your storefront's branding and homepage copy.</p>
          </div>
          <div class="header-actions">
            <button class="btn btn-primary" id="btn-save-settings">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Save Changes
            </button>
          </div>
        </div>

        <div class="card" style="max-width: 800px;">
          <div class="card-header">
            <h2 class="card-title">General Settings</h2>
            <p class="card-desc">These details are used in the navigation bar and SEO tags.</p>
          </div>
          <div class="card-content" style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div class="grid-2">
              <div>
                <label class="label">Store Name</label>
                <input type="text" id="set-name" class="input" placeholder="Vaishali Foods" />
              </div>
              <div>
                <label class="label">SEO Description</label>
                <input type="text" id="set-desc" class="input" placeholder="Pure Tradition, Fresh Taste" />
              </div>
            </div>
            <hr style="border: 0; border-top: 1px solid var(--card-border);" />
            <div>
              <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.25rem;">Homepage Hero Section</h3>
              <p class="card-desc" style="margin-bottom: 1rem;">The main text shown to customers when they land on your site.</p>
              
              <div style="margin-bottom: 1rem;">
                <label class="label">Hero Title</label>
                <input type="text" id="set-hero-title" class="input" placeholder="Authentic Indian Sweets" />
              </div>
              <div>
                <label class="label">Hero Subtitle</label>
                <textarea id="set-hero-sub" class="input" rows="2" placeholder="Handcrafted with love, delivered to your door."></textarea>
              </div>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Product Modal -->
  <div class="modal-backdrop" id="product-modal">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title" id="pm-title">New Product</div>
        <button class="btn btn-icon btn-ghost" onclick="closeProductModal()">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <div>
          <label class="label">Product Name</label>
          <input type="text" id="pm-name" class="input" placeholder="e.g. Khajur Laddoo" />
        </div>
        <div>
          <label class="label">Short Description (Note)</label>
          <input type="text" id="pm-note" class="input" placeholder="e.g. No Added Sugar" />
        </div>
        <div class="grid-2">
          <div>
            <label class="label">Category</label>
            <select id="pm-category" class="input">
              <option>Sweets</option>
              <option>Snacks</option>
              <option>Combos</option>
            </select>
          </div>
          <div>
            <label class="label">Visibility</label>
            <select id="pm-featured" class="input">
              <option value="true">Featured (Show on Homepage)</option>
              <option value="false">Hidden from Homepage</option>
            </select>
          </div>
        </div>
        <div>
          <label class="label">Image URL</label>
          <input type="url" id="pm-img" class="input" placeholder="https://..." />
        </div>

        <div style="margin-top: 0.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <label class="label" style="margin: 0;">Weight Variants & Pricing</label>
            <button class="btn btn-secondary btn-icon" style="padding: 0.25rem 0.75rem; font-size: 0.75rem;" onclick="addVariantRow()">+ Add</button>
          </div>
          <div id="pm-variants"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeProductModal()">Cancel</button>
        <button class="btn btn-primary" id="btn-save-product">Save Product</button>
      </div>
    </div>
  </div>

  <div class="toast-container" id="toaster"></div>

  <script>
    // --- State ---
    let token = localStorage.getItem('vaishali_admin_token');
    let products = [];
    let orders = [];
    let editingProductId = null;

    if (window.innerWidth < 768) {
      document.getElementById('mobile-header').classList.remove('hidden');
    }

    // --- UI Helpers ---
    function toast(msg, type = 'success') {
      const el = document.createElement('div');
      el.className = `toast ${type === 'error' ? 'error' : ''}`;
      el.innerHTML = `
        ${type === 'success' ? '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>' : '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'}
        ${msg}
      `;
      document.getElementById('toaster').appendChild(el);
      requestAnimationFrame(() => {
        el.classList.add('show');
        setTimeout(() => {
          el.classList.remove('show');
          setTimeout(() => el.remove(), 300);
        }, 3000);
      });
    }

    function rupee(val) {
      return val === null || val === undefined ? '—' : '\u20B9' + Number(val).toLocaleString('en-IN');
    }
    
    function slug(str) {
      return str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    }

    // --- Auth & Navigation ---
    const checkAuth = () => {
      if (token) {
        document.getElementById('login-page').classList.add('hidden');
        document.getElementById('dashboard-page').classList.remove('hidden');
        loadData();
      } else {
        document.getElementById('login-page').classList.remove('hidden');
        document.getElementById('dashboard-page').classList.add('hidden');
      }
    };

    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button');
      btn.disabled = true;
      btn.textContent = 'Signing in...';
      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: document.getElementById('username').value,
            password: document.getElementById('password').value
          })
        });
        const data = await res.json();
        if (data.success) {
          token = data.token;
          localStorage.setItem('vaishali_admin_token', token);
          checkAuth();
        } else {
          const err = document.getElementById('login-error');
          err.textContent = data.error;
          err.classList.remove('hidden');
        }
      } catch (err) {
        toast('Connection error', 'error');
      }
      btn.disabled = false;
      btn.textContent = 'Sign In';
    });

    document.getElementById('logout-btn').addEventListener('click', () => {
      localStorage.removeItem('vaishali_admin_token');
      token = null;
      checkAuth();
    });

    document.querySelectorAll('.nav-item').forEach(el => {
      el.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        el.classList.add('active');
        document.getElementById(`view-${el.dataset.target}`).classList.add('active');
        if (window.innerWidth < 768) {
          document.getElementById('sidebar').classList.remove('open');
        }
      });
    });

    // --- Data Loading ---
    async function loadData() {
      try {
        const [pRes, oRes, sRes] = await Promise.all([
          fetch('/api/admin/products'),
          fetch('/api/admin/orders', { headers: { 'Authorization': `Bearer ${token}` } }),
          fetch('/api/admin/settings')
        ]);
        
        if (oRes.status === 401) {
          document.getElementById('logout-btn').click();
          return;
        }

        products = await pRes.json();
        orders = await oRes.json();
        const settings = await sRes.json();
        
        renderProducts();
        renderOrders();
        renderStats();
        
        // Populate settings
        document.getElementById('set-name').value = settings.siteName || '';
        document.getElementById('set-desc').value = settings.siteDescription || '';
        document.getElementById('set-hero-title').value = settings.heroTitle || '';
        document.getElementById('set-hero-sub').value = settings.heroSubtitle || '';
      } catch (err) {
        toast('Failed to load data', 'error');
      }
    }

    function renderStats() {
      const totalRev = orders.reduce((sum, o) => sum + (o.total || 0), 0);
      document.getElementById('stat-rev').textContent = rupee(totalRev);
      document.getElementById('stat-orders').textContent = orders.length;
      document.getElementById('stat-products').textContent = products.length;
    }

    function renderOrders() {
      const buildRow = (o) => {
        const date = new Date(o.date).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        const badge = (o.status === 'paid' || o.payment_id) ? '<span class="badge badge-green">Paid</span>' : '<span class="badge badge-amber">Pending</span>';
        const items = (o.cart || []).map(c => `${c.qty}x ${c.name} (${c.weight})`).join('<br>');
        const cust = o.customer ? `<strong>${o.customer.name}</strong><br><span style="color:var(--text-muted);font-size:0.8rem">${o.customer.phone}</span>` : 'â€”';
        return `
          <tr>
            <td class="cell-id">#${o.order_id.slice(-6).toUpperCase()}</td>
            <td style="white-space: nowrap;">${date}</td>
            <td>${cust}</td>
            <td class="cell-items">${items}</td>
            <td>${badge}</td>
            <td style="text-align: right; font-weight: 600;">${rupee(o.total)}</td>
          </tr>
        `;
      };
      
      const tbody = document.getElementById('all-orders');
      const tbodySm = document.getElementById('overview-orders');
      
      if (!orders.length) {
        const empty = `<tr><td colspan="6" style="text-align:center; padding: 3rem; color: var(--text-muted);">No orders found.</td></tr>`;
        tbody.innerHTML = empty;
        tbodySm.innerHTML = empty;
        return;
      }
      
      tbody.innerHTML = orders.map(buildRow).join('');
      tbodySm.innerHTML = orders.slice(0, 5).map(buildRow).join('');
    }

    function renderProducts() {
      const grid = document.getElementById('products-grid');
      if (!products.length) {
        grid.innerHTML = `<div style="grid-column: 1/-1; text-align:center; padding: 4rem; color: var(--text-muted);">No products found. Create your first product.</div>`;
        return;
      }
      
      grid.innerHTML = products.map(p => {
        const variantsHTML = (p.variants || []).map(v => `
          <div class="pc-variant-row">
            <span class="pc-weight">${v.weight}</span>
            <span class="pc-price">${rupee(v.price)}</span>
          </div>
        `).join('');
        
        return `
          <div class="card product-card">
            <img src="${p.image || ''}" class="pc-img" alt="${p.name}" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'100%\\' height=\\'100%\\'><rect width=\\'100%\\' height=\\'100%\\' fill=\\'%23f1f5f9\\'/></svg>'" />
            <div class="pc-body">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.25rem;">
                <h3 class="pc-title">${p.name}</h3>
                ${p.featured ? '<span class="badge badge-blue" style="font-size:0.6rem;">Featured</span>' : ''}
              </div>
              <p class="pc-note">${p.note || ''}</p>
              <div class="pc-variants">${variantsHTML}</div>
              <div class="pc-actions">
                <button class="btn btn-secondary" onclick="openProductModal('${p.id}')">Edit Details</button>
                <button class="btn btn-danger btn-icon" onclick="deleteProduct('${p.id}')">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // --- Product Editor Modal ---
    function openProductModal(id = null) {
      editingProductId = id;
      document.getElementById('pm-title').textContent = id ? 'Edit Product' : 'Create Product';
      
      const p = id ? products.find(x => x.id === id) : { variants: [{ weight: '500 g', weightGrams: 500, price: '' }] };
      
      document.getElementById('pm-name').value = p.name || '';
      document.getElementById('pm-note').value = p.note || '';
      document.getElementById('pm-category').value = p.category || 'Sweets';
      document.getElementById('pm-featured').value = p.featured === false ? 'false' : 'true';
      document.getElementById('pm-img').value = p.image || '';
      
      const vCont = document.getElementById('pm-variants');
      vCont.innerHTML = '';
      (p.variants || []).forEach(v => addVariantRow(v.weight, v.weightGrams, v.price));
      
      document.getElementById('product-modal').classList.add('open');
    }
    
    function closeProductModal() {
      document.getElementById('product-modal').classList.remove('open');
    }
    
    function addVariantRow(label = '', grams = '', price = '') {
      const div = document.createElement('div');
      div.className = 'variant-row';
      div.innerHTML = `
        <input type="text" class="input vr-label" placeholder="Weight Label (e.g. 500 g)" value="${label}" />
        <input type="number" class="input vr-grams" placeholder="Grams" value="${grams}" />
        <input type="number" class="input vr-price" placeholder="Price â‚¹" value="${price}" />
        <button class="btn btn-ghost btn-icon" onclick="this.parentElement.remove()">âœ•</button>
      `;
      document.getElementById('pm-variants').appendChild(div);
    }

    document.getElementById('btn-save-product').addEventListener('click', async () => {
      const name = document.getElementById('pm-name').value.trim();
      if (!name) return toast('Name is required', 'error');

      const variants = [...document.querySelectorAll('.variant-row')].map(row => ({
        weight: row.querySelector('.vr-label').value.trim(),
        weightGrams: parseInt(row.querySelector('.vr-grams').value) || 0,
        price: parseFloat(row.querySelector('.vr-price').value) || 0,
        id: editingProductId ? editingProductId + '-' + slug(row.querySelector('.vr-label').value) : slug(name) + '-' + slug(row.querySelector('.vr-label').value)
      })).filter(v => v.weight);

      const payload = {
        id: editingProductId || slug(name),
        name,
        note: document.getElementById('pm-note').value.trim(),
        category: document.getElementById('pm-category').value,
        featured: document.getElementById('pm-featured').value === 'true',
        image: document.getElementById('pm-img').value.trim(),
        variants
      };

      const newList = editingProductId 
        ? products.map(p => p.id === editingProductId ? payload : p)
        : [...products, payload];

      const btn = document.getElementById('btn-save-product');
      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        const res = await fetch('/api/admin/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify(newList)
        });
        if (res.ok) {
          products = newList;
          renderProducts();
          renderStats();
          closeProductModal();
          toast('Product saved');
        } else throw new Error();
      } catch (err) {
        toast('Failed to save product', 'error');
      }
      
      btn.disabled = false;
      btn.textContent = 'Save Product';
    });

    async function deleteProduct(id) {
      if (!confirm('Delete this product permanently?')) return;
      const newList = products.filter(p => p.id !== id);
      try {
        const res = await fetch('/api/admin/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify(newList)
        });
        if (res.ok) {
          products = newList;
          renderProducts();
          renderStats();
          toast('Product deleted');
        } else throw new Error();
      } catch (err) {
        toast('Failed to delete product', 'error');
      }
    }

    // --- Settings Save ---
    document.getElementById('btn-save-settings').addEventListener('click', async (e) => {
      const btn = e.target.closest('button');
      btn.disabled = true;
      
      const payload = {
        siteName: document.getElementById('set-name').value.trim(),
        siteDescription: document.getElementById('set-desc').value.trim(),
        heroTitle: document.getElementById('set-hero-title').value.trim(),
        heroSubtitle: document.getElementById('set-hero-sub').value.trim()
      };

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          toast('Settings saved successfully');
        } else throw new Error();
      } catch (err) {
        toast('Failed to save settings', 'error');
      }
      btn.disabled = false;
    });

    checkAuth();
  </script>
</body>
</html>





