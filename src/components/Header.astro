<header class="header">
  <div class="container nav">
    <a class="brand" href="/">
      <img src="/images/logo.png" alt="Vaishali Foods logo" />

      <div class="brand-copy">
        <span>Vaishali Foods</span>
        <small>PURE TRADITION, FRESH TASTE</small>
      </div>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/about">Our Story</a>
      <a href="/contact">Contact</a>

      <!-- Logged Out Auth Button -->
      <a href="/login" class="btn btn-auth" id="header-auth-btn" aria-label="Sign Up or Login">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span>Sign Up / Login</span>
      </a>

      <!-- Logged In User Pill -->
      <div class="user-menu" id="header-user-menu" style="display: none;">
        <a href="/login" class="user-pill" id="user-pill" title="View Account">
          <span class="user-avatar" id="user-avatar">VF</span>
          <span class="user-greeting" id="user-greeting">Hi, Friend</span>
        </a>
        <button type="button" class="btn-signout" id="header-signout-btn" title="Sign Out" aria-label="Sign Out">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </button>
      </div>

      <button
        type="button"
        class="btn btn-primary cart-btn"
        id="open-cart"
      >
        Cart
        <span class="cart-count" id="cart-count">0</span>
      </button>
    </nav>

    <button
      type="button"
      class="mobile-menu-toggle"
      id="mobile-menu-toggle"
      aria-label="Toggle mobile menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav">
    <a href="/">Home</a>
    <a href="/shop">Shop</a>
    <a href="/about">Our Story</a>
    <a href="/contact">Contact</a>
    <div class="mobile-nav-actions">
      <!-- Mobile Logged Out Button -->
      <a href="/login" class="btn btn-auth mobile-auth-btn" id="mobile-auth-btn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span>Sign Up / Login</span>
      </a>

      <!-- Mobile Logged In Box -->
      <div class="mobile-user-profile" id="mobile-user-profile" style="display: none;">
        <div class="mobile-user-info">
          <div class="user-avatar" id="mobile-user-avatar">VF</div>
          <div class="mobile-user-copy">
            <strong id="mobile-user-name">User Name</strong>
            <span id="mobile-user-email">user@example.com</span>
          </div>
        </div>
        <button type="button" class="btn btn-secondary mobile-signout-btn" id="mobile-signout-btn">
          Sign Out
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  import {
    getCurrentSession,
    getUserProfile,
    signOutUser,
    onAuthStateChange,
  } from '../lib/supabase.js';

  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  mobileMenuToggle?.addEventListener('click', () => {
    mobileNav?.classList.toggle('open');
  });

  // Close menu when a link is clicked
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.remove('open');
    });
  });

  // Navbar auth state synchronization
  const headerAuthBtn = document.getElementById('header-auth-btn');
  const headerUserMenu = document.getElementById('header-user-menu');
  const userGreeting = document.getElementById('user-greeting');
  const userAvatar = document.getElementById('user-avatar');
  const headerSignoutBtn = document.getElementById('header-signout-btn');

  const mobileAuthBtn = document.getElementById('mobile-auth-btn');
  const mobileUserProfile = document.getElementById('mobile-user-profile');
  const mobileUserName = document.getElementById('mobile-user-name');
  const mobileUserEmail = document.getElementById('mobile-user-email');
  const mobileUserAvatar = document.getElementById('mobile-user-avatar');
  const mobileSignoutBtn = document.getElementById('mobile-signout-btn');

  // Inline visibility must stay breakpoint-aware: CSS hides the desktop
  // auth elements on mobile, and any inline display set here overrides CSS.
  const mobileQuery = window.matchMedia('(max-width: 850px)');
  let currentSession: any = null;

  function applyAuthVisibility() {
    const loggedIn = !!currentSession?.user;
    const mobile = mobileQuery.matches;

    // Desktop header pills live only on desktop.
    if (headerAuthBtn) headerAuthBtn.style.display = !loggedIn && !mobile ? 'inline-flex' : 'none';
    if (headerUserMenu) headerUserMenu.style.display = loggedIn && !mobile ? 'inline-flex' : 'none';

    // Mobile drawer entries live only in the mobile menu.
    if (mobileAuthBtn) mobileAuthBtn.style.display = !loggedIn ? 'flex' : 'none';
    if (mobileUserProfile) mobileUserProfile.style.display = loggedIn ? 'flex' : 'none';
  }

  async function updateNavAuthState(session: any) {
    currentSession = session || null;

    if (session?.user) {
      let displayName = session.user.user_metadata?.full_name || '';
      let email = session.user.email || '';

      if (!displayName) {
        try {
          const profile = await getUserProfile(session.user.id);
          if (profile?.full_name) displayName = profile.full_name;
        } catch (e) {
          // ignore
        }
      }

      const firstName = displayName ? displayName.split(' ')[0] : 'Account';
      const initials = (displayName || email)
        .split(' ')
        .map((w: string) => w[0])
        .join('')
        .substring(0, 2)
        .toUpperCase() || 'VF';

      // Desktop
      if (userGreeting) userGreeting.textContent = `Hi, ${firstName}`;
      if (userAvatar) userAvatar.textContent = initials;

      // Mobile
      if (mobileUserName) mobileUserName.textContent = displayName || 'Valued Customer';
      if (mobileUserEmail) mobileUserEmail.textContent = email;
      if (mobileUserAvatar) mobileUserAvatar.textContent = initials;
    }

    applyAuthVisibility();
  }

  if (typeof mobileQuery.addEventListener === 'function') {
    mobileQuery.addEventListener('change', applyAuthVisibility);
  } else {
    window.addEventListener('resize', applyAuthVisibility);
  }

  // Initial check
  getCurrentSession().then((session) => updateNavAuthState(session));

  // Reactive listener
  onAuthStateChange((_event: string, session: any) => {
    updateNavAuthState(session);
  });

  // Handle logout
  async function handleLogout() {
    try {
      await signOutUser();
      window.location.href = '/';
    } catch (err) {
      console.error('Logout error:', err);
    }
  }

  headerSignoutBtn?.addEventListener('click', handleLogout);
  mobileSignoutBtn?.addEventListener('click', handleLogout);
</script>
