---
import '../styles/global.css';
const { title = 'Vaishali Foods', description = 'Pure Tradition, Fresh Taste' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <title>{title}</title>
</head>
<body><slot /></body>
</html>
