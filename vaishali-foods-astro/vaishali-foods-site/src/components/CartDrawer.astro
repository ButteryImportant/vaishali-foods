<div class="drawer-backdrop" id="drawer-backdrop"></div>

<aside
  class="drawer"
  id="cart-drawer"
  aria-label="Shopping cart"
>
  <div class="drawer-head">
    <div>
      <span class="eyebrow">Your order</span>
      <h3>Shopping cart</h3>
    </div>

    <button
      type="button"
      class="icon-btn"
      id="close-cart"
      aria-label="Close cart"
    >
      ×
    </button>
  </div>

  <div class="cart-items" id="cart-items"></div>

  <div class="drawer-foot">
    <div class="total-row">
      <span>Subtotal</span>
      <span id="cart-total">₹0</span>
    </div>

    <button
      type="button"
      class="btn btn-primary"
      style="width: 100%;"
      id="checkout-btn"
    >
      Proceed to checkout
    </button>

    <small
      style="display: block; margin-top: 10px; color: var(--brown-soft);"
    >
      Secure payment powered by Razorpay.
    </small>
  </div>
</aside>

<script is:inline>
  const PRODUCTS_KEY = 'vf-cart';

  let cart = [];

  try {
    const storedCart = JSON.parse(
      localStorage.getItem(PRODUCTS_KEY) || '[]'
    );

    cart = Array.isArray(storedCart) ? storedCart : [];
  } catch {
    cart = [];
  }

  const drawer = document.getElementById('cart-drawer');
  const backdrop = document.getElementById('drawer-backdrop');
  const count = document.getElementById('cart-count');
  const items = document.getElementById('cart-items');
  const total = document.getElementById('cart-total');
  const openCartButton = document.getElementById('open-cart');
  const closeCartButton = document.getElementById('close-cart');
  const checkoutButton = document.getElementById('checkout-btn');

  function money(value) {
    return new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    }).format(value);
  }

  function getItemKey(item) {
    return `${item.id}-${item.weight}`;
  }

  function save() {
    localStorage.setItem(PRODUCTS_KEY, JSON.stringify(cart));
    render();
  }

  function render() {
    const itemCount = cart.reduce(
      (sum, item) => sum + Number(item.qty || 0),
      0
    );

    if (count) {
      count.textContent = String(itemCount);
    }

    const subtotal = cart.reduce((sum, item) => {
      return (
        sum +
        Number(item.price || 0) *
          Number(item.qty || 0)
      );
    }, 0);

    if (total) {
      total.textContent = money(subtotal);
    }

    if (!items) return;

    if (!cart.length) {
      items.innerHTML = `
        <div class="empty">
          Your cart is empty.<br />
          Add something delicious.
        </div>
      `;

      return;
    }

    items.innerHTML = cart
      .map((item, index) => {
        const quantity = Number(item.qty || 1);
        const itemTotal =
          Number(item.price || 0) * quantity;

        return `
          <div class="cart-item">
            <div>
              <strong>${item.name}</strong>

              <small>
                ${item.weight} · ${money(item.price)}
              </small>

              <div class="qty-controls">
                <button
                  type="button"
                  data-action="minus"
                  data-index="${index}"
                  aria-label="Decrease quantity"
                >
                  −
                </button>

                <span>${quantity}</span>

                <button
                  type="button"
                  data-action="plus"
                  data-index="${index}"
                  aria-label="Increase quantity"
                >
                  +
                </button>
              </div>
            </div>

            <strong>${money(itemTotal)}</strong>
          </div>
        `;
      })
      .join('');
  }

  function open() {
    drawer?.classList.add('open');
    backdrop?.classList.add('open');
  }

  function close() {
    drawer?.classList.remove('open');
    backdrop?.classList.remove('open');
  }

  openCartButton?.addEventListener('click', (event) => {
    event.preventDefault();
    open();
  });

  closeCartButton?.addEventListener('click', close);
  backdrop?.addEventListener('click', close);

  document
    .querySelectorAll('.add-to-cart')
    .forEach((button) => {
      button.addEventListener('click', () => {
        const product = JSON.parse(
          button.dataset.product
        );

        const productKey = getItemKey(product);

        const existingItem = cart.find(
          (item) => getItemKey(item) === productKey
        );

        if (existingItem) {
          existingItem.qty =
            Number(existingItem.qty || 1) + 1;
        } else {
          cart.push({
            ...product,
            qty: 1
          });
        }

        save();
        open();
      });
    });

  items?.addEventListener('click', (event) => {
    const button = event.target.closest(
      'button[data-action]'
    );

    if (!button) return;

    const index = Number(button.dataset.index);

    if (
      !Number.isInteger(index) ||
      !cart[index]
    ) {
      return;
    }

    if (button.dataset.action === 'plus') {
      cart[index].qty =
        Number(cart[index].qty || 1) + 1;
    }

    if (button.dataset.action === 'minus') {
      cart[index].qty =
        Number(cart[index].qty || 1) - 1;
    }

    if (Number(cart[index].qty) <= 0) {
      cart.splice(index, 1);
    }

    save();
  });

  checkoutButton?.addEventListener('click', () => {
    if (!cart.length) {
      alert('Your cart is empty.');
      return;
    }

    window.location.href = '/checkout';
  });

  window.addEventListener('storage', (event) => {
    if (event.key !== PRODUCTS_KEY) return;

    try {
      const updatedCart = JSON.parse(
        event.newValue || '[]'
      );

      cart = Array.isArray(updatedCart)
        ? updatedCart
        : [];
    } catch {
      cart = [];
    }

    render();
  });

  render();
</script>