---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Checkout | Vaishali Foods"
  description="Review your Vaishali Foods order and enter your delivery details."
  showCart={false}
>
  <section class="checkout-hero">
    <div class="container">
      <span class="eyebrow">Secure checkout</span>
      <h1>Complete your order</h1>
      <p>
        Enter your delivery details and review your products before payment.
      </p>
    </div>
  </section>

  <section class="checkout-section">
    <div class="container checkout-layout">
      <form class="checkout-form" id="checkout-form">
        <section class="checkout-card">
          <div class="checkout-card-heading">
            <span>01</span>

            <div>
              <h2>Contact information</h2>
              <p>We’ll use these details for order and delivery updates.</p>
            </div>
          </div>

          <div class="checkout-fields two-columns">
            <label>
              Full name
              <input
                type="text"
                name="name"
                autocomplete="name"
                placeholder="Your full name"
                required
              />
            </label>

            <label>
              Phone number
              <input
                type="tel"
                name="phone"
                autocomplete="tel"
                inputmode="numeric"
                placeholder="10-digit mobile number"
                maxlength="10"
                pattern="[0-9]{10}"
                required
              />
            </label>

            <label class="full-width">
              Email address
              <input
                type="email"
                name="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
              />
            </label>
          </div>
        </section>

        <section class="checkout-card">
          <div class="checkout-card-heading">
            <span>02</span>

            <div>
              <h2>Delivery address</h2>
              <p>Enter a complete address to avoid courier delays.</p>
            </div>
          </div>

          <div class="checkout-fields two-columns">
            <label class="full-width">
              Flat, house number or building
              <input
                type="text"
                name="addressLine1"
                autocomplete="address-line1"
                placeholder="House number, building or apartment"
                required
              />
            </label>

            <label class="full-width">
              Street, area or locality
              <input
                type="text"
                name="addressLine2"
                autocomplete="address-line2"
                placeholder="Street, area, landmark"
                required
              />
            </label>

            <label>
              City
              <input
                type="text"
                name="city"
                autocomplete="address-level2"
                placeholder="City"
                required
              />
            </label>

            <label>
              State
              <select name="state" autocomplete="address-level1" required>
                <option value="">Select state</option>
                <option>Maharashtra</option>
                <option>Andhra Pradesh</option>
                <option>Arunachal Pradesh</option>
                <option>Assam</option>
                <option>Bihar</option>
                <option>Chhattisgarh</option>
                <option>Goa</option>
                <option>Gujarat</option>
                <option>Haryana</option>
                <option>Himachal Pradesh</option>
                <option>Jharkhand</option>
                <option>Karnataka</option>
                <option>Kerala</option>
                <option>Madhya Pradesh</option>
                <option>Manipur</option>
                <option>Meghalaya</option>
                <option>Mizoram</option>
                <option>Nagaland</option>
                <option>Odisha</option>
                <option>Punjab</option>
                <option>Rajasthan</option>
                <option>Sikkim</option>
                <option>Tamil Nadu</option>
                <option>Telangana</option>
                <option>Tripura</option>
                <option>Uttar Pradesh</option>
                <option>Uttarakhand</option>
                <option>West Bengal</option>
                <option>Delhi</option>
                <option>Chandigarh</option>
                <option>Jammu and Kashmir</option>
                <option>Ladakh</option>
                <option>Puducherry</option>
              </select>
            </label>

            <label>
              PIN code
              <input
                type="text"
                name="pincode"
                id="checkout-pincode"
                autocomplete="postal-code"
                inputmode="numeric"
                maxlength="6"
                pattern="[0-9]{6}"
                placeholder="6-digit PIN code"
                required
              />

              <small id="shipping-status"></small>
            </label>

            <label>
              Landmark
              <input
                type="text"
                name="landmark"
                placeholder="Nearby landmark"
              />
            </label>
          </div>
        </section>

        <section class="checkout-card">
          <div class="checkout-card-heading">
            <span>03</span>

            <div>
              <h2>Order notes</h2>
              <p>Add any useful preparation or delivery instructions.</p>
            </div>
          </div>

          <label class="checkout-textarea-label">
            Notes, allergies or delivery instructions
            <textarea
              name="notes"
              rows="4"
              placeholder="Optional"
            ></textarea>
          </label>
        </section>

        <label class="checkout-consent">
          <input type="checkbox" name="consent" required />

          <span>
            I confirm that the order and delivery details are correct, and I
            agree to the
            <a href="/terms" target="_blank">Terms & Conditions</a>,
            <a href="/shipping-policy" target="_blank">Shipping Policy</a>
            and
            <a href="/refund-policy" target="_blank">Refund Policy</a>.
          </span>
        </label>

        <button
          class="btn btn-primary checkout-mobile-button"
          type="submit"
          id="mobile-payment-button"
          disabled
        >
          Continue to payment
        </button>
      </form>

      <aside class="checkout-summary">
        <div class="checkout-summary-card">
          <div class="checkout-summary-heading">
            <div>
              <span class="eyebrow">Your order</span>
              <h2>Order summary</h2>
            </div>

            <a href="/shop">Edit cart</a>
          </div>

          <div class="checkout-items" id="checkout-items"></div>

          <div class="checkout-empty" id="checkout-empty" hidden>
            <h3>Your cart is empty</h3>
            <p>Add something delicious before continuing.</p>
            <a class="btn btn-secondary" href="/shop">Browse products</a>
          </div>

          <div class="checkout-totals" id="checkout-totals">
            <div>
              <span>Subtotal</span>
              <strong id="checkout-subtotal">₹0</strong>
            </div>

            <div>
              <span>Shipping</span>
              <strong id="checkout-shipping">Enter PIN</strong>
            </div>

            <div class="checkout-total-row">
              <span>Total</span>
              <strong id="checkout-total">₹0</strong>
            </div>
          </div>

          <div class="checkout-payment-note">
            <span>Secure payment</span>
            <p>
              Payment is processed securely through Razorpay. Your card or UPI
              details are never stored on this website.
            </p>
          </div>

          <button
            class="btn btn-primary checkout-desktop-button"
            type="submit"
            form="checkout-form"
            id="desktop-payment-button"
            disabled
          >
            Continue to payment
          </button>

          <p class="checkout-button-note">
            Delivery charges are calculated using your PIN code.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  src="https://checkout.razorpay.com/v1/checkout.js"
></script>

<script is:inline>
  const CART_KEY = 'vf-cart';

  const currency = new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
    maximumFractionDigits: 0
  });

  const itemsContainer = document.querySelector('#checkout-items');
  const emptyState = document.querySelector('#checkout-empty');
  const totalsSection = document.querySelector('#checkout-totals');
  const subtotalElement = document.querySelector('#checkout-subtotal');
  const shippingElement = document.querySelector('#checkout-shipping');
  const totalElement = document.querySelector('#checkout-total');
  const pincodeInput = document.querySelector('#checkout-pincode');
  const shippingStatus = document.querySelector('#shipping-status');
  const form = document.querySelector('#checkout-form');

  const paymentButtons = document.querySelectorAll(
    '#desktop-payment-button, #mobile-payment-button'
  );

  let verifiedShipping = null;
  let shippingRequestId = 0;
  let pincodeTimer;

  function getCart() {
    try {
      const storedCart = JSON.parse(
        localStorage.getItem(CART_KEY) || '[]'
      );

      return Array.isArray(storedCart) ? storedCart : [];
    } catch {
      return [];
    }
  }

  function getItemKey(item) {
    return `${item.id}-${item.weight}`;
  }

  function saveCart(cart) {
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
  }

  function calculateSubtotal(cart) {
    return cart.reduce((total, item) => {
      return (
        total +
        Number(item.price || 0) *
          Number(item.qty || 1)
      );
    }, 0);
  }

  function setPaymentButtonsDisabled(disabled) {
    paymentButtons.forEach((button) => {
      button.disabled = disabled;
    });
  }

  function renderCartTotals() {
    const cart = getCart();
    const subtotal = calculateSubtotal(cart);
    const shipping = verifiedShipping?.amount ?? 0;

    subtotalElement.textContent = currency.format(subtotal);
    totalElement.textContent = currency.format(
      subtotal + shipping
    );

    if (verifiedShipping) {
      shippingElement.textContent = currency.format(
        verifiedShipping.amount
      );
    } else if ((pincodeInput?.value || '').length !== 6) {
      shippingElement.textContent = 'Enter PIN';
    }
  }

  async function calculateLiveShipping() {
    const cart = getCart();
    const pincode = pincodeInput?.value.trim() || '';

    verifiedShipping = null;
    renderCartTotals();

    if (!/^[1-9][0-9]{5}$/.test(pincode)) {
      shippingElement.textContent = 'Enter PIN';
      shippingStatus.textContent =
        'Enter a valid 6-digit PIN code.';
      setPaymentButtonsDisabled(true);
      return;
    }

    if (cart.length === 0) {
      return;
    }

    const currentRequestId = ++shippingRequestId;

    shippingElement.textContent = 'Calculating…';
    shippingStatus.textContent =
      'Checking available delivery partners…';

    setPaymentButtonsDisabled(true);

    try {
      const response = await fetch('/api/shipping-rate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          pincode,
          cart: cart.map((item) => ({
            id: item.id,
            weight: item.weight,
            qty: Number(item.qty || 1)
          }))
        })
      });

      const responseText = await response.text();

      let data;

      try {
        data = JSON.parse(responseText);
      } catch {
        throw new Error(
          `Shipping server returned an invalid response (${response.status}).`
        );
      }

      if (currentRequestId !== shippingRequestId) {
        return;
      }

      if (!response.ok || !data.success) {
        throw new Error(
          data.error ||
            'Unable to calculate delivery charges.'
        );
      }

      verifiedShipping = {
        amount: Number(data.shipping),
        pincode,
        courier: data.courier,
        carrier: data.carrier,
        estimateSource: data.estimateSource || 'provider',
        actualWeightGrams: data.actualWeightGrams,
        volumetricWeightGrams: data.volumetricWeightGrams,
        chargeableWeightGrams: data.chargeableWeightGrams,
        dimensions: data.dimensions
      };

      renderCartTotals();

      const courierName =
        verifiedShipping.courier?.name ||
        'Delivery partner';

      const estimate =
        verifiedShipping.courier?.etd ||
        verifiedShipping.courier?.estimatedDeliveryDays;

      const estimateLabel =
        verifiedShipping.estimateSource === 'fallback'
          ? 'Estimated shipping charge'
          : 'Selected delivery partner';

      shippingStatus.textContent = estimate
        ? `${courierName} · Estimated delivery: ${estimate}`
        : `${estimateLabel}`;

      setPaymentButtonsDisabled(false);
    } catch (error) {
      console.error(error);

      verifiedShipping = null;
      shippingElement.textContent = 'Unavailable';
      shippingStatus.textContent =
        error.message ||
        'Delivery is unavailable for this PIN code.';

      renderCartTotals();
      setPaymentButtonsDisabled(true);
    }
  }

  function updateQuantity(itemKey, change) {
    const cart = getCart();

    const item = cart.find(
      (product) => getItemKey(product) === itemKey
    );

    if (!item) return;

    item.qty = Number(item.qty || 1) + change;

    const updatedCart = cart.filter(
      (product) => Number(product.qty) > 0
    );

    saveCart(updatedCart);

    verifiedShipping = null;
    shippingElement.textContent = 'Recalculating…';
    setPaymentButtonsDisabled(true);

    renderCart();

    if (pincodeInput?.value.length === 6) {
      calculateLiveShipping();
    }
  }

  function removeItem(itemKey) {
    const cart = getCart().filter(
      (product) => getItemKey(product) !== itemKey
    );

    saveCart(cart);

    verifiedShipping = null;
    shippingElement.textContent = 'Recalculating…';
    setPaymentButtonsDisabled(true);

    renderCart();

    if (
      cart.length > 0 &&
      pincodeInput?.value.length === 6
    ) {
      calculateLiveShipping();
    }
  }

  function renderCart() {
    const cart = getCart();

    itemsContainer.innerHTML = '';

    if (cart.length === 0) {
      emptyState.hidden = false;
      totalsSection.hidden = true;
      shippingStatus.textContent = '';
      setPaymentButtonsDisabled(true);
      return;
    }

    emptyState.hidden = true;
    totalsSection.hidden = false;

    cart.forEach((item) => {
      const itemKey = getItemKey(item);
      const quantity = Number(item.qty || 1);
      const itemTotal =
        Number(item.price || 0) * quantity;

      const element = document.createElement('article');
      element.className = 'checkout-item';

      element.innerHTML = `
        <div class="checkout-item-image" aria-hidden="true">
          <span>VF</span>
        </div>

        <div class="checkout-item-details">
          <div class="checkout-item-top">
            <div>
              <h3>${item.name}</h3>
              <p>${item.weight}</p>
            </div>

            <strong>${currency.format(itemTotal)}</strong>
          </div>

          <div class="checkout-item-actions">
            <div class="checkout-quantity">
              <button
                type="button"
                data-action="decrease"
                aria-label="Decrease quantity"
              >
                −
              </button>

              <span>${quantity}</span>

              <button
                type="button"
                data-action="increase"
                aria-label="Increase quantity"
              >
                +
              </button>
            </div>

            <button
              type="button"
              class="checkout-remove"
              data-action="remove"
            >
              Remove
            </button>
          </div>
        </div>
      `;

      element
        .querySelector('[data-action="decrease"]')
        ?.addEventListener('click', () => {
          updateQuantity(itemKey, -1);
        });

      element
        .querySelector('[data-action="increase"]')
        ?.addEventListener('click', () => {
          updateQuantity(itemKey, 1);
        });

      element
        .querySelector('[data-action="remove"]')
        ?.addEventListener('click', () => {
          removeItem(itemKey);
        });

      itemsContainer.appendChild(element);
    });

    renderCartTotals();

    if (!verifiedShipping) {
      setPaymentButtonsDisabled(true);
    }
  }

  function setPaymentButtonsLoading(isLoading) {
    paymentButtons.forEach((button) => {
      button.disabled = isLoading;

      button.textContent = isLoading
        ? 'Preparing payment...'
        : 'Continue to payment';
    });
  }

  function showCheckoutError(message) {
    alert(message);
  }

  pincodeInput?.addEventListener('input', () => {
    pincodeInput.value = pincodeInput.value
      .replace(/\D/g, '')
      .slice(0, 6);

    clearTimeout(pincodeTimer);
    shippingRequestId += 1;
    verifiedShipping = null;

    renderCartTotals();
    setPaymentButtonsDisabled(true);

    if (pincodeInput.value.length === 6) {
      shippingElement.textContent = 'Waiting…';
      shippingStatus.textContent =
        'Preparing delivery calculation…';

      pincodeTimer = setTimeout(() => {
        calculateLiveShipping();
      }, 400);
    } else {
      shippingElement.textContent = 'Enter PIN';
      shippingStatus.textContent = '';
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const cart = getCart();

    if (cart.length === 0) {
      window.location.href = '/shop';
      return;
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const customer = Object.fromEntries(
      new FormData(form).entries()
    );

    if (
      !verifiedShipping ||
      verifiedShipping.pincode !== customer.pincode
    ) {
      showCheckoutError(
        'Please enter your PIN code and wait for delivery charges to be calculated.'
      );

      await calculateLiveShipping();
      return;
    }

    if (typeof window.Razorpay !== 'function') {
      showCheckoutError(
        'The payment window could not load. Check your connection and try again.'
      );
      return;
    }

    sessionStorage.setItem(
      'vf-checkout-details',
      JSON.stringify(customer)
    );

    setPaymentButtonsLoading(true);

    try {
      const orderResponse = await fetch('/api/create-order', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          pincode: customer.pincode,
          cart: cart.map((item) => ({
            id: item.id,
            weight: item.weight,
            qty: Number(item.qty || 1)
          }))
        })
      });

      const responseText = await orderResponse.text();

      let order;

      try {
        order = JSON.parse(responseText);
      } catch {
        throw new Error(
          `Payment server returned an invalid response (${orderResponse.status}).`
        );
      }

      if (!orderResponse.ok) {
        throw new Error(
          order.error ||
            'Unable to create your payment order.'
        );
      }

      const razorpay = new window.Razorpay({
        key: order.key_id,
        amount: order.amount,
        currency: order.currency,
        name: 'Vaishali Foods',
        description: 'Pure Tradition, Fresh Taste',
        image: '/images/logo.png',
        order_id: order.order_id,

        prefill: {
          name: customer.name,
          email: customer.email,
          contact: customer.phone
        },

        notes: {
          address: [
            customer.addressLine1,
            customer.addressLine2,
            customer.city,
            customer.state,
            customer.pincode
          ]
            .filter(Boolean)
            .join(', ')
        },

        theme: {
          color: '#5b3923'
        },

        modal: {
          ondismiss() {
            setPaymentButtonsLoading(false);
            setPaymentButtonsDisabled(false);
          }
        },

        async handler(paymentResponse) {
          try {
            const verificationResponse = await fetch(
              '/api/verify-payment',
              {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  ...paymentResponse,
                  customer,
                  cart: cart.map((item) => ({
                    id: item.id,
                    weight: item.weight,
                    qty: Number(item.qty || 1)
                  }))
                })
              }
            );

            const verificationText =
              await verificationResponse.text();

            let verification;

            try {
              verification = JSON.parse(
                verificationText
              );
            } catch {
              throw new Error(
                'The payment verification server returned an invalid response.'
              );
            }

            if (
              !verificationResponse.ok ||
              !verification.success
            ) {
              throw new Error(
                verification.error ||
                  'Payment verification failed.'
              );
            }

            sessionStorage.setItem(
              'vf-payment-result',
              JSON.stringify({
                paymentId: verification.payment_id,
                orderId: verification.order_id,
                customer,
                cart,
                shipping: verifiedShipping,
                shipmentCreated: verification.shipmentCreated,
                carrier: verification.carrier,
                shipmentError: verification.shipmentError || null
              })
            );

            localStorage.removeItem(CART_KEY);

            alert(
              verification.shipmentCreated
                ? `Payment successful! Your ${verification.carrier} shipment has been created.`
                : `Payment successful! Your order is confirmed. Shipment booking will be completed manually.`
            );

            window.location.href = '/';
          } catch (error) {
            console.error(error);

            showCheckoutError(
              'Payment was received but verification could not be completed. Please contact Vaishali Foods before paying again.'
            );
          } finally {
            setPaymentButtonsLoading(false);
          }
        }
      });

      razorpay.on('payment.failed', (response) => {
        console.error(
          'Payment failed:',
          response.error
        );

        setPaymentButtonsLoading(false);
        setPaymentButtonsDisabled(false);

        showCheckoutError(
          response.error?.description ||
            'Payment failed. No order has been confirmed.'
        );
      });

      razorpay.open();
    } catch (error) {
      console.error(error);

      setPaymentButtonsLoading(false);
      setPaymentButtonsDisabled(false);

      showCheckoutError(
        error.message ||
          'Unable to start payment. Please try again.'
      );
    }
  });

  renderCart();
</script>